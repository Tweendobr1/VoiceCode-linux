[Unit]
Description=VoiceCode — голосовой помощник opencode
Documentation=file:///usr/share/doc/voicecode/README.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/voicecode
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
